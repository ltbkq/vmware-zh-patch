msg.cui.toolsInfoBar.txtWin8 = "如果未看到 VMware Tools 正在安装，请按 Windows 徽标键 + R，然后输入 D:\setup.exe（其中 D: 是您的虚拟 CD-ROM 驱动器）。"
msg.cui.toolsInfoBar.txtWinVista7 = "如果未看到 VMware Tools 正在安装，请单击 Windows 图标，然后在“搜索”框中输入 D:\setup.exe（其中 D: 是您的虚拟 CD-ROM 驱动器）。"
msg.cui.toolsInfoBar.txtWinOther = "如果未看到 VMware Tools 正在安装，请在虚拟机中单击“开始”>“运行”，然后输入 D:\setup.exe（其中 D: 是您的虚拟 CD-ROM 驱动器）。"
msg.cui.toolsInfoBar.txtLinux = "在客户机中挂载虚拟 CD 驱动器，启动终端，然后使用 tar 解压缩安装程序。接着执行 vmware-install.pl 以安装 VMware Tools。"
msg.cui.toolsInfoBar.txtOther = "请参阅 Tools 安装指南了解安装说明。"
msg.cui.toolsInfoBar.txtInstaller = "VMware Tools 正在安装。请按照客户机操作系统中的说明完成安装。"
msg.cui.toolsInfoBar.txtErrorImage = "此客户机操作系统的 VMware Tools 安装映像不可访问。如果当前正在下载 VMware Tools，请等待下载完成。"
msg.cui.toolsInfoBar.txtErrorSigCheck = "此客户机操作系统的 VMware Tools 安装映像没有有效签名，可能已损坏。请重新下载 VMware Tools 或重新安装产品。"
